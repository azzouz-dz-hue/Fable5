# Copiez ce fichier en « .env » et renseignez vos valeurs.
# .env est ignoré par git — il ne doit JAMAIS être versionné.
#
# Le trousseau système reste préférable pour les mots de passe :
#   bankextract login bna
# Les variables ci-dessous ne servent que si le trousseau est indisponible
# (serveur sans session graphique, conteneur, tâche planifiée).

# --- Identifiants bancaires -------------------------------------------------
BNA_USERNAME=
BNA_PASSWORD=

CPA_USERNAME=
CPA_PASSWORD=

BEA_USERNAME=
BEA_PASSWORD=

SGA_USERNAME=
SGA_PASSWORD=

AGB_USERNAME=
AGB_PASSWORD=

# --- Passerelle SMS (OTP automatique) ---------------------------------------
# Jeton d'accès de l'application passerelle installée sur le téléphone Android.
SMS_GATEWAY_TOKEN=

# --- OTP par e-mail (fournisseur « imap ») ----------------------------------
OTP_IMAP_USER=
OTP_IMAP_PASSWORD=

# --- Envoi des relevés par courriel -----------------------------------------
# Mot de passe du compte d'envoi. Avec Gmail ou Microsoft 365, créez un
# « mot de passe d'application » plutôt que d'utiliser celui du compte.
SMTP_PASSWORD=

# --- Divers -----------------------------------------------------------------
# Chromium déjà présent sur le poste (évite le téléchargement Playwright).
# BANKEXTRACT_CHROMIUM=/usr/bin/chromium

# Banque de démonstration (tests).
BANKEXTRACT_DEMO_USERNAME=demo
BANKEXTRACT_DEMO_PASSWORD=demo123
